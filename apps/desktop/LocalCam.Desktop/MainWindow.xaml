<Window x:Class="LocalCam.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DeskCam" Icon="/Assets/LocalCam.ico" Width="1000" Height="700" MinWidth="460" MinHeight="460"
 Background="#111614" Foreground="#ECF4EF" FontFamily="Segoe UI" InputMethod.IsInputMethodEnabled="False" KeyDown="Window_KeyDown">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#29392F"/><Setter Property="Foreground" Value="#EDF6EF"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,6,0"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#3B5846"/><Setter Property="Foreground" Value="#ECF4EF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#B9EDCF"/><Setter TargetName="Chrome" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel x:Name="Header" Margin="16,12">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button Content="连接手机" Click="Pair_Click"/><Button Content="设置" Click="Settings_Click"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal"><TextBlock Text="DeskCam" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="纸面预览" Foreground="#9CAD9F" VerticalAlignment="Center" Margin="14,0"/></StackPanel>
  </DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <Grid x:Name="Viewport" Focusable="True" Background="#080B09" ClipToBounds="True"
    MouseWheel="Viewport_MouseWheel" MouseLeftButtonDown="Viewport_MouseDown"
    MouseMove="Viewport_MouseMove" MouseLeftButtonUp="Viewport_MouseUp">
   <Image x:Name="PreviewImage" Stretch="Uniform"/>
   <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" Margin="24">
    <TextBlock Text="让桌面出现在这里" FontSize="24" TextAlignment="Center"/>
    <TextBlock x:Name="EmptyText" Text="首次使用点击“连接手机”。之后打开手机 DeskCam 即可。" TextWrapping="Wrap" Foreground="#9CAD9F" TextAlignment="Center" Margin="0,12,0,0"/>
   </StackPanel>
   <Canvas IsHitTestVisible="False"><Rectangle x:Name="Selection" Visibility="Collapsed" Stroke="#B9EDCF" StrokeThickness="2" Fill="#22B9EDCF"/></Canvas>
   <Border x:Name="FrozenLabel" Visibility="Collapsed" Background="#D029392F" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="10,6">
    <TextBlock Text="已冻结预览 · webcam 继续实时"/>
   </Border>
   <Border x:Name="InspectBox" Visibility="Collapsed" Background="#111614" BorderBrush="#B9EDCF" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Padding="8" IsHitTestVisible="False">
    <StackPanel><TextBlock Text="100% 细字检查 · 鼠标所指位置" Margin="0,0,0,6"/><Image x:Name="InspectImage" Stretch="None" HorizontalAlignment="Left"/></StackPanel>
   </Border>
  </Grid>
  <ContentControl x:Name="CameraSidebar" Grid.Column="1" Width="320" Visibility="Collapsed"/>
  </Grid>
  <StackPanel x:Name="Controls" Grid.Row="2" Margin="14,12">
   <WrapPanel Margin="0,0,0,8">
    <Button Content="复制 Ctrl+C" Click="Copy_Click" Background="#B9EDCF" Foreground="#123B25" ToolTip="复制当前裁剪后原像素图片；不会受预览窗口大小影响"/>
    <Button Content="保存 Ctrl+S" Click="SaveFrame_Click" ToolTip="保存当前预览或冻结帧，包含裁剪和方向"/>
    <Button x:Name="FreezeButton" Content="冻结 Space" Click="Freeze_Click" ToolTip="固定当前预览，方便连续截图；再次按 Space 恢复"/>
    <Button x:Name="FocusLockButton" Content="锁定焦点 L" Click="FocusLock_Click"/>
    <Button x:Name="AutofocusButton" Content="自动对焦 A" Click="Autofocus_Click" ToolTip="重新打开自动对焦；观察细字确认清晰后再锁焦"/>
    <Button Content="高清抓拍 H" Click="CaptureHD_Click" ToolTip="获取完整高清采集帧；4K 档位无需重开相机"/>
    <Button Content="纯净 F11" Click="Clean_Click" ToolTip="隐藏界面截图；Esc 或双击画面退出"/>
   </WrapPanel>
   <Expander x:Name="SecondaryActions" Header="画面调整与帮助" IsExpanded="True" Foreground="#9CAD9F">
   <WrapPanel Margin="0,7,0,0">
    <Button Content="旋转 R" Click="Rotate_Click"/><Button x:Name="CropButton" Content="裁剪 C" Click="Crop_Click"/>
    <Button Content="重置 0" Click="Reset_Click"/>
    <Button x:Name="TopButton" Content="置顶" Click="Top_Click"/>
    <Button Content="相机控制" Click="CameraControls_Click"/>

    <Button Content="最近一张" Click="RecentPhoto_Click"/>
    <Button x:Name="InspectButton" Content="细字检查 I" Click="Inspect_Click"/>
    <Button Content="使用帮助 F1" Click="Help_Click"/>
   </WrapPanel>
   </Expander>
   <TextBlock x:Name="StatusText" Foreground="#9CAD9F" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Text="等待手机"/>
   <TextBlock x:Name="CaptureText" Foreground="#B9EDCF" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
   <Expander Header="摄像头兼容状态" Foreground="#829689" FontSize="11" Margin="0,4,0,0"><TextBlock x:Name="CameraText" TextWrapping="Wrap"/></Expander>
  </StackPanel>
 </Grid>
</Window>
