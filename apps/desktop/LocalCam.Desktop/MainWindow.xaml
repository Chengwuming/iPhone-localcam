<Window x:Class="LocalCam.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalCam" Icon="/Assets/LocalCam.ico" Width="1200" Height="780" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3" Foreground="#1C1B1F" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#0067C0" /><Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="16,9" />
            <Setter Property="Margin" Value="0,0,8,0" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#005A9E" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#004578" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#FFFFFF" /><Setter Property="Foreground" Value="#242424" />
            <Setter Property="Padding" Value="14,8" /><Setter Property="BorderBrush" Value="#D1D1D1" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F0F0F0" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E5E5E5" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="32,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="20" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="连接 iPhone" Style="{StaticResource ActionButton}" Click="ConnectIphone_Click" />
                <Button Content="设置" Style="{StaticResource SubtleButton}" Click="Settings_Click" />
                <Button Content="帮助" Style="{StaticResource SubtleButton}" Click="ConnectionHelp_Click" Margin="0" />
            </StackPanel>
            <StackPanel><TextBlock Text="LocalCam" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="iPhone 本地摄像头与 Windows 虚拟摄像头" Foreground="#616161" Margin="0,4,0,0" /></StackPanel>
        </DockPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="330" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#101010" CornerRadius="10" ClipToBounds="True">
                <Grid><Image x:Name="PreviewImage" Stretch="Uniform" /><StackPanel x:Name="EmptyPreview" HorizontalAlignment="Center" VerticalAlignment="Center" Width="250"><TextBlock Text="等待 iPhone 摄像头" Foreground="White" FontSize="18" HorizontalAlignment="Center" /><TextBlock Text="点击右上角“连接 iPhone”开始配对" Foreground="#C8C8C8" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel></Grid>
            </Border>
            <Border Grid.Row="1" Background="White" BorderBrush="#E1E1E1" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock x:Name="ConnectionStatus" Text="正在连接本地预览服务…" Foreground="#107C10" FontWeight="SemiBold" />
                    <TextBlock x:Name="Metrics" Text="尚未收到视频帧" Foreground="#616161" Margin="0,3,0,14" />
                    <WrapPanel><Button Content="后置摄像头" Style="{StaticResource SubtleButton}" Click="RearCamera_Click" /><Button Content="前置摄像头" Style="{StaticResource SubtleButton}" Click="FrontCamera_Click" /><Button Content="20 FPS" Style="{StaticResource SubtleButton}" Click="Fps20_Click" /><Button Content="30 FPS" Style="{StaticResource SubtleButton}" Click="Fps30_Click" /><Button Content="完整显示" Style="{StaticResource SubtleButton}" Click="Fit_Click" /><Button Content="铺满窗口" Style="{StaticResource SubtleButton}" Click="Fill_Click" /><Button x:Name="MirrorButton" Content="摄像头镜像：关闭" Style="{StaticResource SubtleButton}" Click="Mirror_Click" /></WrapPanel>
                    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="实时缩放" VerticalAlignment="Center" Margin="0,0,12,0" /><Slider x:Name="ZoomSlider" Grid.Column="1" Minimum="0.5" Maximum="10" Value="1" VerticalAlignment="Center" ValueChanged="ZoomSlider_ValueChanged" /><TextBlock x:Name="ZoomText" Grid.Column="2" Text="1.0×" Width="48" VerticalAlignment="Center" Margin="12,0,0,0" /></Grid>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Grid.RowSpan="2" Background="White" BorderBrush="#E1E1E1" BorderThickness="1" CornerRadius="8" Padding="22" Margin="20,0,0,0">
                <StackPanel><TextBlock Text="设备状态" FontSize="18" FontWeight="SemiBold" /><Border Background="#F5F9FF" CornerRadius="6" Padding="14" Margin="0,16,0,0"><StackPanel><TextBlock Text="iPhone 摄像头" FontWeight="SemiBold" /><TextBlock x:Name="DeviceStatusText" Text="等待连接" Foreground="#616161" Margin="0,4,0,0" /></StackPanel></Border><TextBlock Text="连接方式" FontWeight="SemiBold" Margin="0,24,0,6" /><TextBlock Text="支持可互访的同一 Wi-Fi、iPhone 个人热点、Windows 移动热点和 USB 个人热点。桌面程序会自动启动本地连接服务。" Foreground="#616161" TextWrapping="Wrap" LineHeight="22" /><Separator Margin="0,22,0,18" Background="#E5E5E5" /><TextBlock Text="系统摄像头" FontWeight="SemiBold" /><TextBlock x:Name="VirtualCameraStatusText" Text="正在启动 LocalCam Camera…" Foreground="#616161" TextWrapping="Wrap" LineHeight="22" Margin="0,6,0,0" /><TextBlock Text="虚拟摄像头只在 LocalCam 运行时接入系统；退出软件后会自动移除。" Foreground="#616161" TextWrapping="Wrap" LineHeight="22" Margin="0,5,0,0" /><Separator Margin="0,22,0,18" Background="#E5E5E5" /><TextBlock Text="显示提示" FontWeight="SemiBold" /><TextBlock Text="完整显示保留全部画面；铺满窗口会裁掉边缘。缩放拖动时实时发送到 iPhone；摄像头镜像会同时作用于 LocalCam 预览和虚拟摄像头输出。" Foreground="#616161" TextWrapping="Wrap" LineHeight="22" Margin="0,6,0,0" /></StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
