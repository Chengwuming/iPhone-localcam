<Window x:Class="LocalCam.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DeskCam" Icon="/Assets/LocalCam.ico" Width="1120" Height="760" MinWidth="460" MinHeight="460"
 Background="#0D1014" Foreground="#E9EEF5" FontFamily="Segoe UI" FontSize="13" InputMethod.IsInputMethodEnabled="False"
 PreviewKeyDown="Window_KeyDown" PreviewMouseMove="Window_PreviewMouseMove">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Background" Value="#282E37"/><Setter Property="Foreground" Value="#E9EEF5"/>
   <Setter Property="BorderBrush" Value="#3B444F"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="13,9"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#3A4653"/><Setter Property="Foreground" Value="White"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#475C61"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#9CE2CB"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#E9EEF5"/><Setter Property="Padding" Value="12,10"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Option" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="5"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Option" Property="Background" Value="#34434B"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Option" Property="Background" Value="#29423D"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Foreground" Value="#E9EEF5"/><Setter Property="MinHeight" Value="38"/><Setter Property="Background" Value="#252C35"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Foreground="#E9EEF5" Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#252C35" BorderBrush="#3A444F" BorderThickness="1" CornerRadius="8"><Grid><ContentPresenter TextElement.Foreground="#E9EEF5" Margin="12,9,32,9" Content="{Binding SelectionBoxItem,RelativeSource={RelativeSource AncestorType=ComboBox}}"/><TextBlock Text="⌄" Foreground="#9AABB9" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center"/></Grid></Border></ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#1D252D" BorderBrush="#40505D" BorderThickness="1" CornerRadius="9" Padding="5" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="320"><ItemsPresenter/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TrackButton" TargetType="RepeatButton"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Slider"><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="MinHeight" Value="32"/><Setter Property="IsMoveToPointEnabled" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Margin="8,0"><Track x:Name="PART_Track">
    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource TrackButton}" Background="#91D9C0" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
    <Track.Thumb><Thumb Width="18" Height="18"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="9" Background="#D4F5E9" BorderBrush="#151C20" BorderThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource TrackButton}" Background="#414C58" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
   </Track></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="7"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="#47515C" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
  <Grid x:Name="Viewport" Focusable="True" Background="#0A0D10" ClipToBounds="True"
    MouseWheel="Viewport_MouseWheel" MouseLeftButtonDown="Viewport_MouseDown" MouseMove="Viewport_MouseMove" MouseLeftButtonUp="Viewport_MouseUp">
   <Image x:Name="PreviewImage" Stretch="Uniform"/>
   <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="32">
    <Border Width="68" Height="68" CornerRadius="22" Background="#202D30" Margin="0,0,0,22"><TextBlock Text="◉" Foreground="#9CE2CB" FontSize="35" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <TextBlock Text="手机放好，画面就在这里" FontSize="25" FontWeight="SemiBold" TextAlignment="Center"/>
    <TextBlock x:Name="EmptyText" Text="打开手机 DeskCam，连接后自动进入预览。" TextWrapping="Wrap" Foreground="#95A4B4" TextAlignment="Center" Margin="0,12,0,22"/>
    <Button Content="连接手机" Click="Pair_Click" HorizontalAlignment="Center" Background="#9CE2CB" Foreground="#12372E" Padding="22,11"/>
    <TextBlock Text="无需每天扫码 · 已配对可直接打开原入口" Foreground="#647584" TextAlignment="Center" FontSize="12" Margin="0,16,0,0"/>
   </StackPanel>
   <Canvas IsHitTestVisible="False"><Rectangle x:Name="Selection" Visibility="Collapsed" Stroke="#9CE2CB" StrokeThickness="2" Fill="#229CE2CB"/></Canvas>
   <Border x:Name="FrozenLabel" Visibility="Collapsed" Background="#E6253338" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,76,0,0" Padding="12,7" IsHitTestVisible="False"><TextBlock Text="已冻结 · Space 恢复"/></Border>
   <Border x:Name="InspectBox" Visibility="Collapsed" Background="#F0192028" BorderBrush="#5A8276" BorderThickness="1" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20,20,20,92" Padding="12" IsHitTestVisible="False"><StackPanel><TextBlock Text="100% 细字检查" Foreground="#9CE2CB" Margin="0,0,0,8"/><Image x:Name="InspectImage" Stretch="None" HorizontalAlignment="Left"/></StackPanel></Border>
  </Grid>
  <Border x:Name="Notice" Visibility="Collapsed" Background="#F024343A" CornerRadius="9" Padding="14,9" Margin="22,0,22,112" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False"><TextBlock x:Name="NoticeText" TextWrapping="Wrap" MaxWidth="440" Foreground="#D6F6E9"/></Border>
  <Grid x:Name="Header" VerticalAlignment="Top" Margin="20,16">
   <Border HorizontalAlignment="Left" Background="#EC192129" CornerRadius="12" Padding="15,10"><StackPanel Orientation="Horizontal"><TextBlock Text="DeskCam" FontWeight="SemiBold" FontSize="17"/><TextBlock x:Name="ConnectionBadge" Text="待连接" Foreground="#91D9C0" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="12"/></StackPanel></Border>
   <Border HorizontalAlignment="Right" Background="#EC192129" CornerRadius="12" Padding="3"><StackPanel Orientation="Horizontal"><Button Content="连接" ToolTip="连接手机" Click="Pair_Click" Background="Transparent"/><Button Content="设置" Click="Settings_Click" Background="Transparent"/></StackPanel></Border>
  </Grid>
  <Border x:Name="Controls" VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="1030" Margin="16" Background="#F0192129" BorderBrush="#35414D" BorderThickness="1" CornerRadius="14" Padding="8">
   <StackPanel>
    <WrapPanel HorizontalAlignment="Center">
     <Button Content="复制" AutomationProperties.Name="复制 Ctrl+C" Click="Copy_Click" ToolTip="Ctrl+C · 复制当前取景的原像素" Background="#9CE2CB" Foreground="#13392E"/>
     <Button x:Name="FreezeButton" Content="冻结" AutomationProperties.Name="冻结 Space" Click="Freeze_Click" ToolTip="Space · 冻结 / 恢复"/>
     <Button Content="铺满" AutomationProperties.Name="铺满视窗 F" Click="Fill_Click" ToolTip="F · 等比铺满视窗，可拖动平移；裁掉的边缘不会复制"/>
     <Button Content="完整" AutomationProperties.Name="完整画面 0" Click="Reset_Click" ToolTip="0 · 恢复完整画面"/>
     <Button x:Name="FocusLockButton" Content="锁焦" AutomationProperties.Name="锁定焦点 L" Click="FocusLock_Click"/>
     <Button x:Name="AutofocusButton" Content="对焦" AutomationProperties.Name="自动对焦 A" Click="Autofocus_Click" ToolTip="A · 重新自动对焦"/>
     <Button Content="高清抓拍" AutomationProperties.Name="高清抓拍 H" Click="CaptureHD_Click" ToolTip="H · 抓拍完整高清帧"/>
     <Button Content="调节" AutomationProperties.Name="相机控制" Click="CameraControls_Click" ToolTip="P · 相机参数与手机控制"/>
    </WrapPanel>
    <Expander x:Name="SecondaryActions" Header="更多操作" IsExpanded="False" Foreground="#94A6B6" Margin="8,3,8,0">
     <StackPanel Margin="0,10,0,0"><WrapPanel>
      <Button Content="保存 PNG" AutomationProperties.Name="保存 Ctrl+S" Click="SaveFrame_Click" ToolTip="Ctrl+S · 保存当前取景"/>
      <Button Content="旋转" AutomationProperties.Name="旋转 R" Click="Rotate_Click" ToolTip="R"/><Button x:Name="CropButton" Content="裁剪" AutomationProperties.Name="裁剪 C" Click="Crop_Click" ToolTip="C · 框选取景区域"/>
      <Button x:Name="TopButton" Content="置顶" Click="Top_Click"/><Button Content="最近一张" Click="RecentPhoto_Click"/>
      <Button x:Name="InspectButton" Content="细字检查" AutomationProperties.Name="细字检查 I" Click="Inspect_Click" ToolTip="I"/>
      <Button Content="纯净" AutomationProperties.Name="纯净 F11" Click="Clean_Click" ToolTip="F11 · 完全隐藏工具；Esc 退出"/>
      <Button Content="使用帮助" AutomationProperties.Name="使用帮助 F1" Click="Help_Click"/>
     </WrapPanel><TextBlock x:Name="StatusText" Foreground="#8499A9" FontSize="12" TextWrapping="Wrap" Margin="4,9,4,0"/>
     <Expander Header="摄像头兼容状态" Foreground="#718493" FontSize="11" Margin="4,6,4,0"><TextBlock x:Name="CameraText" TextWrapping="Wrap"/></Expander></StackPanel>
    </Expander>
    <TextBlock x:Name="CaptureText" Foreground="#9CE2CB" FontSize="12" TextWrapping="Wrap" Margin="8,4,8,0"/>
   </StackPanel>
  </Border>
  <Border x:Name="SidebarShell" Width="320" HorizontalAlignment="Right" Margin="16,76,16,110" Background="#F21B232C" BorderBrush="#36434E" BorderThickness="1" CornerRadius="14" Visibility="Collapsed" Padding="0,4">
   <DockPanel><Button DockPanel.Dock="Top" Content="完成调节  ×" Click="CameraControls_Click" HorizontalAlignment="Right" Background="Transparent" Margin="8"/><ContentControl x:Name="CameraSidebar"/></DockPanel>
  </Border>
 </Grid>
</Window>
