<Window x:Class="LocalCam.Desktop.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连接 iPhone"
        Icon="/Assets/LocalCam.ico"
        Width="900"
        Height="800"
        MinWidth="520"
        MinHeight="560"
        Background="#F3F3F3"
        Foreground="#1C1B1F"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="SubtleButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#242424" />
            <Setter Property="BorderBrush" Value="#D1D1D1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="连接 iPhone" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="首次先安装证书；之后每次只需扫描连接二维码" Margin="0,5,0,0" Foreground="#605E5C" FontSize="14" />
            </StackPanel>

            <Border Grid.Row="1" Margin="0,20,0,0" Padding="18" Background="#F5F9FF" BorderBrush="#CFE4FF" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="选择连接网络" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="MobileHotspotHint" Text="若校园网不允许设备互访，推荐开启 iPhone“个人热点”并让 Windows 加入后刷新；也可使用 Windows 移动热点。VMware 等虚拟网卡不会显示。" Margin="0,6,0,12" Foreground="#36516A" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="NetworkSelector" MinHeight="34" DisplayMemberPath="DisplayName" SelectionChanged="NetworkSelector_SelectionChanged" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                            <Button Content="刷新" Style="{StaticResource SubtleButton}" Click="RefreshNetworks_Click" />
                            <Button Content="打开移动热点设置" Style="{StaticResource SubtleButton}" Click="OpenMobileHotspotSettings_Click" Margin="0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Margin="0,14,0,0" Padding="22" Background="White" BorderBrush="#E1DFDD" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="连接 iPhone" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="SelectedNetworkText" Text="正在检测连接网络…" Margin="0,6,0,0" Foreground="#605E5C" TextWrapping="Wrap" />
                    <Border Margin="0,18,0,10" Padding="8" HorizontalAlignment="Center" Background="#FFFFFF" BorderBrush="#E1DFDD" BorderThickness="1" CornerRadius="8">
                        <Image x:Name="PhoneQr" Width="260" Height="260" SnapsToDevicePixels="True" />
                    </Border>
                    <TextBlock Text="请用 iPhone 相机扫描，打开 Safari 后点“开始本地传输”并允许使用摄像头。" HorizontalAlignment="Center" Foreground="#605E5C" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="ExpiryText" HorizontalAlignment="Center" Foreground="#605E5C" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                <Expander Foreground="#1C1B1F">
                    <Expander.Header>
                        <TextBlock Text="首次使用：安装并完全信任本地 HTTPS 证书" FontWeight="SemiBold" />
                    </Expander.Header>
                    <Border Margin="0,10,0,0" Padding="18" Background="#FFFFFF" BorderBrush="#E1DFDD" BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="此步骤只需对这台 iPhone 和这台电脑完成一次，与 WLAN、Windows 移动热点或 USB 无关：扫描下方二维码，按 iPhone 提示安装描述文件；安装后还必须到“设置 → 通用 → 关于本机 → 证书信任设置”，为 LocalCam Local CA 开启完全信任。若 Safari 显示“此连接非私人连接”，说明完全信任尚未生效。完成后回到上方重新生成并扫描连接二维码。" Foreground="#605E5C" TextWrapping="Wrap" />
                            <Border Margin="0,14,0,0" Padding="8" HorizontalAlignment="Center" Background="White" BorderBrush="#E1DFDD" BorderThickness="1" CornerRadius="8">
                                <Image x:Name="BootstrapQr" Width="260" Height="260" SnapsToDevicePixels="True" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Expander>
                <TextBlock x:Name="ErrorText" Margin="0,14,0,0" Foreground="#C42B1C" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
