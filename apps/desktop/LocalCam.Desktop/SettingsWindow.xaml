<Window x:Class="LocalCam.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalCam 设置" Icon="/Assets/LocalCam.ico" Width="560" Height="565"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F3F3F3" Foreground="#1C1B1F" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="这些设置只保存在本机。" Foreground="#616161" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2">
            <Border Background="White" BorderBrush="#E1E1E1" BorderThickness="1" CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="点击关闭按钮时" FontWeight="SemiBold" />
                        <TextBlock Text="选择退出整个程序，或保留服务并隐藏到托盘。" Foreground="#616161" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                    <ComboBox x:Name="CloseBehaviorSelector" Grid.Column="1" MinHeight="34" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="关闭 LocalCam" Tag="Exit" />
                        <ComboBoxItem Content="最小化到托盘" Tag="MinimizeToTray" />
                    </ComboBox>
                </Grid>
            </Border>
            <Border Background="White" BorderBrush="#E1E1E1" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="开机自动启动" FontWeight="SemiBold" />
                        <TextBlock Text="登录 Windows 后在托盘中启动 LocalCam。" Foreground="#616161" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                    <CheckBox x:Name="StartWithWindowsCheckBox" Grid.Column="1" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Background="White" BorderBrush="#E1E1E1" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="软件更新" FontWeight="SemiBold" />
                        <TextBlock x:Name="CurrentVersionText" Foreground="#616161" Margin="0,5,0,0" />
                        <TextBlock x:Name="UpdateStatusText" Foreground="#616161" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button x:Name="CheckUpdateButton" Grid.Column="1" Content="检查更新" Style="{StaticResource SubtleButton}" Margin="0" VerticalAlignment="Center" Click="CheckUpdate_Click" />
                </Grid>
            </Border>
            <TextBlock x:Name="ErrorText" Foreground="#C42B1C" TextWrapping="Wrap" Margin="2,12,2,0" />
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource SubtleButton}" Click="Cancel_Click" />
            <Button Content="保存" Style="{StaticResource ActionButton}" Margin="0" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
