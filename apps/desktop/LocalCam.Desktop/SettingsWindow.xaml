<Window x:Class="LocalCam.Desktop.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DeskCam 设置" Width="460" Height="340" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 Background="#111614" Foreground="#ECF4EF" FontFamily="Segoe UI">
 <StackPanel Margin="24">
  <TextBlock Text="设置" FontSize="24" FontWeight="SemiBold"/>
  <CheckBox x:Name="StartWithWindowsCheckBox" Content="随 Windows 启动，在托盘等待手机" Foreground="#ECF4EF" Margin="0,24,0,18"/>
  <TextBlock Text="关闭预览窗口时" Margin="0,0,0,6"/>
  <ComboBox x:Name="CloseBehaviorSelector" Height="30">
   <ComboBoxItem Content="缩到托盘，继续接收画面" Tag="MinimizeToTray"/>
   <ComboBoxItem Content="退出 DeskCam" Tag="Exit"/>
  </ComboBox>
  <TextBlock x:Name="ErrorText" Foreground="#F0B7A6" TextWrapping="Wrap" Margin="0,12,0,12"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="取消手机配对" Click="Unpair_Click" Padding="12,7" Margin="0,0,12,0"/>
   <Button Content="保存" Click="Save_Click" Padding="18,7" Margin="0,0,8,0"/>
   <Button Content="取消" Click="Cancel_Click" Padding="18,7"/>
  </StackPanel>
 </StackPanel>
</Window>
