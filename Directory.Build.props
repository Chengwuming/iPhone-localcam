<Project>
  <PropertyGroup>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion>0.2.0</InformationalVersion>
    <Authors>LocalCam contributors</Authors>
    <Copyright>Copyright (c) 2026 LocalCam contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl Condition="'$(GitHubRepository)' != ''">https://github.com/$(GitHubRepository)</RepositoryUrl>
  </PropertyGroup>
</Project>
